# Optional remote Qdrant cluster. Leave QDRANT_CLUSTER_ENDPOINT empty for local persistent mode.
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=industrial_knowledge
QDRANT_PATH=outputs/qdrant

# FastEmbed model name; downloaded on first embed call.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional corpus / artifact locations
# INDUSTRIAL_RAG_DATA_DIR=DATA
# INDUSTRIAL_RAG_PROCESSED_DIR=processed_data
